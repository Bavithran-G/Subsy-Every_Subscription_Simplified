# Copy to backend/.env and adjust. All settings use the SUBSY_ prefix.
SUBSY_ENVIRONMENT=development
SUBSY_DATABASE_URL=postgresql+psycopg://subsy:subsy@localhost:5432/subsy
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SUBSY_SECRET_KEY=change-me
SUBSY_FRONTEND_URL=http://localhost:5173
SUBSY_CORS_ORIGINS=http://localhost:5173

# Email. Leave SMTP_HOST empty to disable delivery: emails are then recorded in the
# outbox (Administration -> Email outbox) with status "not_sent" and are NOT delivered.
SUBSY_SMTP_HOST=
SUBSY_SMTP_PORT=587
SUBSY_SMTP_USER=
SUBSY_SMTP_PASSWORD=
SUBSY_SMTP_FROM=Subsy <no-reply@example.com>

# Daily automation (billing, auto-close, reminders, overdue scan) at this hour, Asia/Kolkata
SUBSY_SCHEDULER_ENABLED=true
SUBSY_BILLING_CRON_HOUR=1
SUBSY_RENEWAL_REMINDER_DAYS=7
